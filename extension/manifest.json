{
  "manifest_version": 3,
  "name": "Lecture Notes Assistant",
  "description": "Record lectures or YouTube videos and generate structured notes",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "tabCapture",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "offscreen_documents": [
    "offscreen.html"
  ]
}